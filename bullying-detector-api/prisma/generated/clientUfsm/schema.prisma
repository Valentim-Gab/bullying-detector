generator clientUfsm {
  provider = "prisma-client-js"
  output   = "./generated/clientUfsm"
}

datasource ufsmDb {
  provider = "postgresql"
  url      = env("UFSM_DATABASE_URL")
}

model Avaliation {
  idAvaliation           Int      @id @map("id_avaliation")
  mainText               String?  @map("main_text")
  bertClassification     String?  @map("bert_classification") @ufsmDb.VarChar(20)
  studentSituation       String?  @map("student_situation") @ufsmDb.VarChar(255)
  finalAverage           Float?   @map("final_average")
  concept                String?  @map("concept") @ufsmDb.VarChar(50)
  detected               Boolean? @default(false)
  bullyingClassification Float?   @map("bullying_classification")

  @@map("avaliation")
}
